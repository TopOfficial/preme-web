# Server-only HTTPS email gateway, accepting JSON: from, to[], reply_to, subject, text.
# Connect an existing authorised gateway and verified sender before enabling online delivery.
ECI_MAIL_ENDPOINT=
ECI_MAIL_TOKEN=
ECI_MAIL_FROM=

# Optional shared rate-limit store. Use a TLS rediss:// URL in production.
ECI_REDIS_URL=
